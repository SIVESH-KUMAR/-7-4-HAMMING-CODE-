// ======================= Hamming(7,4) Encoder =======================
module hamming74_encoder (
    input  [3:0] data_in,    // 4-bit input data
    output [6:0] code_out    // 7-bit encoded output
);

    wire p1, p2, p3;

    // Parity bits (even parity)
    assign p1 = data_in[0] ^ data_in[1] ^ data_in[3]; // d1 ^ d2 ^ d4
    assign p2 = data_in[0] ^ data_in[2] ^ data_in[3]; // d1 ^ d3 ^ d4
    assign p3 = data_in[1] ^ data_in[2] ^ data_in[3]; // d2 ^ d3 ^ d4

    // Arrange codeword: [p1 p2 d1 p3 d2 d3 d4]
    assign code_out = {p1, p2, data_in[0], p3, data_in[1], data_in[2], data_in[3]};

endmodule

